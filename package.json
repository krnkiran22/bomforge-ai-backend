{
  "name": "bomforge-backend",
  "version": "1.0.0",
  "description": "BOMForge AI Backend - Manufacturing BOM Conversion Service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "ollama:start": "bash scripts/start-ollama.sh",
    "ollama:check": "node scripts/check-ollama.js",
    "ollama:pull": "ollama pull llama3.1:8b",
    "dev:full": "concurrently --kill-others-on-fail --prefix-colors \"cyan,magenta,green\" --names \"OLLAMA,BACKEND,HEALTH\" \"npm run ollama:start\" \"npm run dev:backend\" \"npm run health:check\"",
    "dev:backend": "sleep 3 && tsx watch src/index.ts",
    "health:check": "node scripts/health-check.js",
    "setup": "npm run ollama:pull && npm run dev:full",
    "verify": "node scripts/pre-start.js"
  },
  "keywords": [
    "bom",
    "manufacturing",
    "ai",
    "conversion"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^8.22.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.24.1",
    "papaparse": "^5.4.1",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mongoose": "^5.11.96",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/papaparse": "^5.3.12",
    "concurrently": "^9.2.1",
    "nodemon": "^3.0.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
